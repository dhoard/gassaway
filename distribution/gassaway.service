[Unit]
# Generated by install.sh from the repository template, with the program prefix,
# the service account, the port and the projects directory substituted. Do not
# edit the installed copy: the next uninstall.sh/install.sh cycle regenerates it
# from this file.
Description=gassaway memory server
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Type=exec reports an exec failure as a unit failure instead of a briefly
# successful start, so a wrong prefix or a broken binary is visible immediately.
Type=exec
User=@USER@
Group=@USER@
# Absolute paths and a fixed loopback address: nothing here depends on the
# caller's working directory. There is deliberately no ExecStartPost probe: a
# request fired at start-up would race the listener; install.sh polls /healthz
# after starting the service instead.
ExecStart=@PREFIX@/bin/gassaway --host 127.0.0.1 --port @PORT@ --project @PROJECTS_DIR@
Restart=on-failure
RestartSec=2
# The server shuts down on SIGTERM within its own 5 s context.
TimeoutStopSec=10

# State directory: systemd creates and owns it, so no script has to, and the
# mode survives reinstalls. 0750 with UMask=0027 keeps the graphs owner-only;
# the writer already creates files 0600.
StateDirectory=gassaway
StateDirectoryMode=0750
UMask=0027

# Confinement. The server receives project IDs, never client directories, so it
# needs no access to home directories and no writable path beyond its state.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
# Loopback only, at the socket and at the cgroup. --host is fixed to 127.0.0.1
# for exactly this reason: a configurable host would make these two lines wrong.
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
